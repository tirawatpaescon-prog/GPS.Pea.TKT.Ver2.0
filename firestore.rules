rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /streetlight_surveys/{peano} {
      allow read: if true;
      allow write: if request.resource.data.peano is string
                   && request.resource.data.status in ['สำรวจแล้ว', 'ยังไม่สำรวจ']
                   && request.resource.data.updatedAt is number;
    }
    match /recloser_logs/{logId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                           && request.resource.data.recloserId is string
                           && request.resource.data.createdAt is number;
      allow delete: if true;
    }
    match /test/connection {
      allow read: if true;
    }
  }
}
